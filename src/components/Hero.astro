---
import { site } from '../data/site';

// Wortlaut laut BRIEF.md, Abschnitt 4.1 (Stand: Aruns Feedback zum Hero)
const facts = [
  { key: 'Ausgezeichnet', text: 'Matura, HTL Donaustadt Informatik' },
  { key: 'PlantUp', text: 'Diplomarbeit, ein Jahr im 4er-Team' },
  { key: 'Octapharma', text: 'Praktikum IT-Compliance' },
];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 class="hero__name" id="hero-name">{site.name}</h1>
      <p class="hero__lead">
        Informatik-Student an der FH Technikum Wien. Ich baue Apps mit sauberen Oberflächen,
        durchdachten Animationen und einem Backend, das mitspielt.
      </p>

      <ul class="hero__facts">
        {
          facts.map((f) => (
            <li>
              <span class="hero__fact-key">{f.key}</span>
              <span class="hero__fact-text">{f.text}</span>
            </li>
          ))
        }
      </ul>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#projekte">Projekte ansehen</a>
        {
          site.cvPdf && (
            <a class="btn btn--secondary" href={site.cvPdf}>
              Lebenslauf (PDF)
            </a>
          )
        }
        <a class="btn btn--secondary" href={site.github} rel="noopener">GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 2.25rem 3.5rem;
  }

  .hero__name {
    font-size: clamp(3.5rem, 17vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .hero__lead {
    max-width: 34em;
    margin-top: 1.125rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .hero__facts {
    margin-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .hero__facts li {
    display: grid;
    grid-template-columns: 8.75rem 1fr;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .hero__fact-key {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .hero__fact-text {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.75rem;
  }

  .hero__actions .btn--primary {
    flex: 1 0 100%;
  }

  .hero__actions .btn--secondary {
    flex: 1 1 0;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: 7rem 8rem;
    }

    .hero__name {
      font-size: clamp(5.5rem, 13vw, 11rem);
    }

    .hero__lead {
      margin-top: 2.25rem;
      font-size: 1.375rem;
      line-height: 1.4;
    }

    .hero__facts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
      max-width: 56rem;
      margin-top: 4.5rem;
      border-top: 0;
    }

    .hero__facts li {
      display: block;
      padding-block: 1.125rem 0;
      border-bottom: 0;
      border-top: 1px solid var(--line);
    }

    .hero__fact-key {
      display: block;
      font-size: 2.25rem;
    }

    .hero__fact-text {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.9375rem;
      text-wrap: balance;
    }

    .hero__actions {
      margin-top: 3.5rem;
    }

    .hero__actions .btn--primary,
    .hero__actions .btn--secondary {
      flex: 0 0 auto;
    }
  }
</style>
