---
import { site } from '../data/site';

// Wortlaut aus BRIEF.md, Abschnitt 4.1
const facts = [
  'Matura mit ausgezeichnetem Erfolg, HTL Donaustadt Informatik',
  'Diplomarbeit PlantUp: 83 Commits, ein Jahr Entwicklung im 4er-Team',
  'IT-Compliance-Praktikum bei Octapharma',
];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="container">
    <h1 class="hero__name" id="hero-name">{site.name}</h1>
    <p class="hero__lead">
      Informatik-Student an der FH Technikum Wien. Ich baue Apps mit sauberen Oberflächen,
      durchdachten Animationen und einem Backend, das mitspielt.
    </p>

    <ul class="hero__facts mono">
      {facts.map((f) => <li>{f}</li>)}
    </ul>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#projekte">Projekte ansehen</a>
      {
        site.cvPdf && (
          <a class="btn btn--secondary" href={site.cvPdf}>
            Lebenslauf (PDF)
          </a>
        )
      }
      <a class="btn btn--secondary" href={site.github} rel="noopener">GitHub</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 1.75rem 3rem;
  }

  .hero__name {
    font-size: clamp(3.5rem, 17vw, 9.5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .hero__lead {
    max-width: 34em;
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--text);
    text-wrap: pretty;
  }

  .hero__facts {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-2);
    line-height: 1.4;
  }

  .hero__facts li {
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--line);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .hero__actions .btn--primary {
    flex: 1 0 100%;
  }

  .hero__actions .btn--secondary {
    flex: 1 1 0;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: 5rem 6rem;
    }

    .hero__lead {
      margin-top: 1.75rem;
      font-size: 1.375rem;
      line-height: 1.4;
    }

    .hero__facts {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-top: 3.5rem;
      border-top: 0;
    }

    .hero__facts li {
      padding-block: 0.875rem 0;
      border-bottom: 0;
      border-top: 1px solid var(--line);
      text-wrap: balance;
    }

    .hero__actions {
      margin-top: 3rem;
    }

    .hero__actions .btn--primary,
    .hero__actions .btn--secondary {
      flex: 0 0 auto;
    }
  }
</style>
