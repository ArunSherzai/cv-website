---
import Phone from './Phone.astro';
import healthScreen from '../../assets/plantup/plantup-health.png';
import feedScreen from '../../assets/plantup/plantup-feed.png';
import statsScreen from '../../assets/plantup/plantup-stats.png';

// Alle Texte laut BRIEF.md, Abschnitt 4.2. „Mein Anteil“ wörtlich, nichts ergänzen.
const screens = [
  {
    src: healthScreen,
    caption: 'Pflanzen-Gesundheit',
    alt: 'PlantUp-App: Pflanzen-Gesundheit mit Maskottchen Sprig, Sensorwerten und Mentor-Hinweis',
  },
  {
    src: feedScreen,
    caption: 'Community-Feed',
    alt: 'PlantUp-App: Community-Feed mit Beiträgen anderer Nutzer',
  },
  {
    src: statsScreen,
    caption: 'Trend-Diagramm Bodenfeuchte',
    alt: 'PlantUp-App: Pflanzen-Statistik mit Trend-Diagramm der Bodenfeuchte',
  },
];

const anteil = [
  {
    label: 'Gamification',
    text: 'Missionen-Screen, Daily Streak, XP-Booster, Freeze-Item, Belohnungs- und XP-Animationen',
  },
  {
    label: 'Maskottchen „Sprig“',
    text: 'mit KI generiert und aufbereitet, zustandsabhängige Animationen und animierte Rahmen in der App umgesetzt',
  },
  {
    label: 'Community',
    text: 'Beiträge erstellen, Feed-Karten, Direktnachrichten, Follow-Benachrichtigungen',
  },
  { text: 'Push-Benachrichtigungen, Einstellungen, Profil und Tutorial' },
  { text: 'Überarbeitung der Pflanzen-Statistik mit Trend-Diagrammen' },
  { label: 'Backend', text: 'C#-MQTT-Middleware und eine Video-Upload-API in ASP.NET' },
];

// Zugeschnittene, komprimierte Fassungen aus scripts/videos.mjs
const sprig = [
  { file: 'sprig-health-100', state: '100 %' },
  { file: 'sprig-health-50', state: '50 %' },
  { file: 'sprig-health-10', state: '10 %' },
];

const zahlen = [
  { value: '83 von 338', label: 'App-Commits (Platz 2 im Team)' },
  { value: '05/2025 – 04/2026', label: 'Zeitraum' },
  { value: 'ca. 42.000', label: 'Zeilen TypeScript im App-Code (gesamtes Team)' },
];

const stack = [
  'React Native',
  'Expo',
  'TypeScript',
  'Zustand',
  'Reanimated',
  'Skia',
  'Supabase (Postgres, Auth, Storage, Edge Functions)',
  'Jest',
  'Maestro',
  'C#/ASP.NET',
  'MQTT',
];

const team = ['Abd-Ulrahman Behari', 'Arun Sherzai', 'Dennis Frenzel', 'Richard Onu'];
---

<section class="section section--line pu" id="projekte" aria-labelledby="plantup-title">
  <div class="container">
    <!-- Kopf: kompakt, ohne großes Bild -->
    <header class="pu-head">
      <div>
        <p class="eyebrow">Diplomarbeit · HTL Donaustadt · 2025/26 · Team aus 4 Personen</p>
        <h2 class="pu-head__title" id="plantup-title">PlantUp</h2>
        <p class="pu-head__lead">
          Smart-Gardening-App, die Pflanzenpflege mit IoT-Sensoren, Gamification und einer
          Community verbindet.
        </p>
      </div>
      <p class="pu-head__about">
        Sensoren im Blumentopf messen Bodenfeuchte, Temperatur und Licht. Die App zeigt den Zustand
        der Pflanze, gibt Pflegetipps und belohnt regelmäßige Pflege mit XP, Missionen und Streaks.
        Dazu kommen ein Feed, Direktnachrichten und ein Mentor-System, in dem erfahrene Nutzer
        Einsteigern helfen.
      </p>
    </header>
  </div>

  <!-- Eine Reihe mit drei Screens -->
  <div class="pu-screens" role="group" aria-label="Screens der App" tabindex="0">
    {
      screens.map((s) => (
        <figure class="pu-screens__item">
          <Phone src={s.src} alt={s.alt} sizes="(min-width: 48rem) 240px, 56vw" />
          <figcaption class="mono">{s.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="container">
    <!-- Mein Anteil -->
    <div class="pu-anteil">
      <h3 class="pu-h3">Mein Anteil</h3>
      <div>
        <ul class="pu-anteil__list">
          {
            anteil.map((a) => (
              <li>
                {a.label && <strong>{a.label}: </strong>}
                {a.text}
              </li>
            ))
          }
        </ul>
        <p class="pu-anteil__note">Hardware (ESP32, Sensoren, Gehäuse) von meinen Teamkollegen.</p>
      </div>
    </div>

    <!-- Sprig -->
    <div class="pu-sprig">
      <div class="pu-sprig__head">
        <div class="pu-sprig__text">
          <h3 class="pu-h3">Sprig</h3>
          <p class="pu-sub">Das Maskottchen reagiert auf den Zustand der Pflanze.</p>
        </div>
      </div>
      <ul class="pu-sprig__cards">
        {
          sprig.map((v) => (
            <li>
              <video
                muted
                loop
                playsinline
                preload="none"
                width="572"
                height="244"
                poster={`/video/${v.file}.webp`}
                aria-label={`Animierte Gesundheitskarte mit Sprig bei ${v.state} Pflanzengesundheit`}
                data-sprig
              >
                <source src={`/video/${v.file}.mp4`} type="video/mp4" />
                <source src={`/video/${v.file}.webm`} type="video/webm" />
              </video>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Details -->
    <dl class="pu-zahlen">
      {
        zahlen.map((z) => (
          <div>
            <dt>{z.label}</dt>
            <dd>{z.value}</dd>
          </div>
        ))
      }
    </dl>

    <dl class="pu-facts">
      <div>
        <dt class="eyebrow">Tech-Stack</dt>
        <dd>{stack.join(' · ')}</dd>
      </div>
      <div>
        <dt class="eyebrow">Pitch</dt>
        <dd>
          PlantUp wurde im Mai 2025 bei der „4B Pitch Arena“ vor einer Jury aus Wirtschaft und IT
          präsentiert (4-Minuten-Pitch, 10 Minuten Q&amp;A). Danach haben zwei Jurymitglieder die
          Hardware des Projekts finanziert.
        </dd>
      </div>
      <div>
        <dt class="eyebrow">Team</dt>
        <dd>{team.join(', ')}</dd>
      </div>
      <div>
        <dt class="eyebrow">Code</dt>
        <dd>
          <a class="link" href="https://github.com/ArunSherzai/PlantUp" rel="noopener">
            github.com/ArunSherzai/PlantUp
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* Kopf */
  .pu-head__title {
    margin-top: 0.75rem;
    font-size: clamp(4rem, 18vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .pu-head__lead {
    max-width: 24em;
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .pu-head__about {
    max-width: 36em;
    margin-top: 1.25rem;
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* Screens: am Handy waagrecht wischbar, ab Tablet nebeneinander */
  .pu-screens {
    display: flex;
    gap: 1.25rem;
    margin-top: 2.25rem;
    padding-inline: var(--gutter);
    padding-bottom: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .pu-screens::-webkit-scrollbar {
    display: none;
  }

  .pu-screens__item {
    flex: 0 0 56vw;
    scroll-snap-align: start;
  }

  .pu-screens figcaption {
    margin-top: 0.75rem;
    color: var(--text-2);
  }

  .pu-h3 {
    font-size: clamp(2.25rem, 8vw, 3rem);
  }

  /* Mein Anteil */
  .pu-anteil {
    margin-top: 1.5rem;
    padding: 1.75rem 1.5rem;
    background: var(--surface);
    border-radius: 1.5rem;
  }

  .pu-anteil__list {
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .pu-anteil__list li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .pu-anteil__list strong {
    font-weight: 600;
  }

  .pu-anteil__note {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }

  /* Sprig */
  .pu-sprig {
    margin-top: 3.5rem;
  }

  .pu-sub {
    margin-top: 0.625rem;
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .pu-sprig__cards {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  /* Die Videos sind auf die Karte zugeschnitten; der Radius blendet die Ecken der Aufnahme aus. */
  .pu-sprig__cards video {
    display: block;
    width: 100%;
    aspect-ratio: 572 / 244;
    object-fit: cover;
    border-radius: 5.6% / 13.2%;
  }

  /* Kennzahlen */
  .pu-zahlen {
    display: grid;
    gap: 1.125rem;
    margin: 3.5rem 0 0;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  .pu-zahlen div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .pu-zahlen dt {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-2);
  }

  .pu-zahlen dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  /* Stack, Pitch, Team, Code */
  .pu-facts {
    margin: 0;
  }

  .pu-facts > div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .pu-facts dd {
    max-width: 44em;
    margin: 0.375rem 0 0;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .pu-head {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }

    .pu-head__lead {
      font-size: 1.25rem;
    }

    .pu-head__about {
      margin-top: 0;
    }

    .pu-screens {
      justify-content: center;
      gap: clamp(1.5rem, 5vw, 4rem);
      max-width: var(--page-max);
      margin: 3.5rem auto 0;
      padding-bottom: 0;
      overflow: visible;
    }

    .pu-screens__item {
      flex: 0 1 15rem;
    }

    .pu-anteil {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 2.5rem;
      margin-top: 4.5rem;
      padding: 2.75rem 3rem;
      border-radius: 2rem;
    }

    .pu-anteil__list {
      margin-top: 0.25rem;
    }

    .pu-sprig {
      margin-top: 5rem;
    }

    .pu-sprig__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .pu-zahlen {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
      margin-top: 5rem;
      padding-block: 1.75rem;
    }

    .pu-zahlen dd {
      font-size: 1.5rem;
    }

    .pu-facts > div {
      display: grid;
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
      padding-block: 1.125rem;
    }

    .pu-facts dd {
      margin-top: 0;
    }
  }
</style>

<script>
  // Sprig-Videos laufen nur, solange sie sichtbar sind. Bei reduzierter Bewegung kein Autoplay.
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-sprig]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced) {
    videos.forEach((v) => (v.controls = true));
  } else if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.35 },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>
