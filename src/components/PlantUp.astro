---
import Phone from './Phone.astro';
import healthScreen from '../../assets/plantup/plantup-health.png';
import feedScreen from '../../assets/plantup/plantup-feed.png';
import statsScreen from '../../assets/plantup/plantup-stats.png';

// Alle Texte laut BRIEF.md, Abschnitt 4.2. „Mein Anteil“ wörtlich, nichts ergänzen.
const screens = [
  {
    src: feedScreen,
    caption: 'Community-Feed',
    alt: 'PlantUp-App: Community-Feed mit Beiträgen anderer Nutzer',
  },
  {
    src: statsScreen,
    caption: 'Trend-Diagramm Bodenfeuchte',
    alt: 'PlantUp-App: Pflanzen-Statistik mit Trend-Diagramm der Bodenfeuchte',
  },
];

const anteil = [
  {
    label: 'Gamification',
    text: 'Missionen-Screen, Daily Streak, XP-Booster, Freeze-Item, Belohnungs- und XP-Animationen',
  },
  {
    label: 'Maskottchen „Sprig“',
    text: 'mit KI generiert und aufbereitet, zustandsabhängige Animationen und animierte Rahmen in der App umgesetzt',
  },
  {
    label: 'Community',
    text: 'Beiträge erstellen, Feed-Karten, Direktnachrichten, Follow-Benachrichtigungen',
  },
  { text: 'Push-Benachrichtigungen, Einstellungen, Profil und Tutorial' },
  { text: 'Überarbeitung der Pflanzen-Statistik mit Trend-Diagrammen' },
  { label: 'Backend', text: 'C#-MQTT-Middleware und eine Video-Upload-API in ASP.NET' },
];

// Zugeschnittene, komprimierte Fassungen aus scripts/videos.mjs
const sprig = [
  { file: 'sprig-health-100', state: '100 %' },
  { file: 'sprig-health-50', state: '50 %' },
  { file: 'sprig-health-10', state: '10 %' },
];

const zahlen = [
  { value: '83 von 338', label: 'App-Commits (Platz 2 im Team)' },
  { value: '05/2025 – 04/2026', label: 'Zeitraum' },
  { value: 'ca. 42.000', label: 'Zeilen TypeScript im App-Code (gesamtes Team)' },
];

const stack = [
  'React Native',
  'Expo',
  'TypeScript',
  'Zustand',
  'Reanimated',
  'Skia',
  'Supabase (Postgres, Auth, Storage, Edge Functions)',
  'Jest',
  'Maestro',
  'C#/ASP.NET',
  'MQTT',
];

const team = ['Abd-Ulrahman Behari', 'Arun Sherzai', 'Dennis Frenzel', 'Richard Onu'];
---

<section class="pu" id="projekte" aria-labelledby="plantup-title">
  <!-- Auftakt -->
  <div class="pu-intro">
    <div class="container">
      <p class="eyebrow pu-intro__eyebrow">
        Diplomarbeit · HTL Donaustadt · 2025/26 · Team aus 4 Personen
      </p>
      <h2 class="pu-intro__title" id="plantup-title">PlantUp</h2>
      <p class="pu-intro__lead">
        Smart-Gardening-App, die Pflanzenpflege mit IoT-Sensoren, Gamification und einer Community
        verbindet.
      </p>
      <Phone
        class="pu-intro__phone"
        src={healthScreen}
        alt="PlantUp-App: Pflanzen-Gesundheit mit Maskottchen Sprig, Sensorwerten und Mentor-Hinweis"
        sizes="(min-width: 48rem) 320px, 68vw"
      />
    </div>
  </div>

  <!-- Kurzbeschreibung und weitere Screens -->
  <div class="pu-block">
    <div class="container">
      <p class="pu-about">
        Sensoren im Blumentopf messen Bodenfeuchte, Temperatur und Licht. Die App zeigt den Zustand
        der Pflanze, gibt Pflegetipps und belohnt regelmäßige Pflege mit XP, Missionen und Streaks.
        Dazu kommen ein Feed, Direktnachrichten und ein Mentor-System, in dem erfahrene Nutzer
        Einsteigern helfen.
      </p>
    </div>

    <div class="pu-screens" role="group" aria-label="Weitere Screens der App" tabindex="0">
      {
        screens.map((s) => (
          <figure class="pu-screens__item">
            <Phone src={s.src} alt={s.alt} sizes="(min-width: 48rem) 280px, 62vw" />
            <figcaption class="mono">{s.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <!-- Mein Anteil -->
  <div class="pu-block pu-block--tight">
    <div class="container">
      <div class="pu-anteil">
        <h3 class="pu-anteil__title">Mein Anteil</h3>
        <div>
          <ul class="pu-anteil__list">
            {
              anteil.map((a) => (
                <li>
                  {a.label && <strong>{a.label}: </strong>}
                  {a.text}
                </li>
              ))
            }
          </ul>
          <p class="pu-anteil__note">Hardware (ESP32, Sensoren, Gehäuse) von meinen Teamkollegen.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sprig -->
  <div class="pu-block">
    <div class="container">
      <h3 class="pu-h3">Sprig</h3>
      <p class="pu-sub">
        Das Maskottchen reagiert auf den Zustand der Pflanze. Die Animationen sind von mir.
      </p>
      <ul class="pu-sprig">
        {
          sprig.map((v) => (
            <li>
              <video
                muted
                loop
                playsinline
                preload="none"
                width="572"
                height="244"
                poster={`/video/${v.file}.webp`}
                aria-label={`Animierte Gesundheitskarte mit Sprig bei ${v.state} Pflanzengesundheit`}
                data-sprig
              >
                <source src={`/video/${v.file}.mp4`} type="video/mp4" />
                <source src={`/video/${v.file}.webm`} type="video/webm" />
              </video>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Zahlen, Stack, Pitch, Team -->
  <div class="pu-block pu-block--tight">
    <div class="container">
      <dl class="pu-zahlen">
        {
          zahlen.map((z) => (
            <div>
              <dt>{z.label}</dt>
              <dd>{z.value}</dd>
            </div>
          ))
        }
      </dl>

      <dl class="pu-facts">
        <div>
          <dt class="eyebrow">Tech-Stack</dt>
          <dd>{stack.join(' · ')}</dd>
        </div>
        <div>
          <dt class="eyebrow">Pitch</dt>
          <dd>
            PlantUp wurde im Mai 2025 bei der „4B Pitch Arena“ vor einer Jury aus Wirtschaft und IT
            präsentiert (4-Minuten-Pitch, 10 Minuten Q&amp;A). Danach haben zwei Jurymitglieder die
            Hardware des Projekts finanziert.
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Team</dt>
          <dd>{team.join(', ')}</dd>
        </div>
        <div>
          <dt class="eyebrow">Code</dt>
          <dd>
            <a class="link" href="https://github.com/ArunSherzai/PlantUp" rel="noopener">
              github.com/ArunSherzai/PlantUp
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  /* Auftakt, dunkel */
  .pu-intro {
    padding-block: 4.5rem 4rem;
    background: var(--dark);
    color: var(--on-dark);
    text-align: center;
  }

  .pu-intro__eyebrow {
    color: var(--on-dark-2);
  }

  .pu-intro__title {
    margin-top: 1rem;
    font-size: clamp(4.5rem, 22vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .pu-intro__lead {
    max-width: 30em;
    margin: 1.25rem auto 0;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--on-dark);
    text-wrap: balance;
  }

  .pu-intro :global(.pu-intro__phone) {
    width: min(68vw, 20rem);
    margin: 3rem auto 0;
  }

  /* Helle Blöcke */
  .pu-block {
    padding-block: 4rem;
  }

  .pu-block--tight {
    padding-block: 0 4rem;
  }

  .pu-block + .pu-block:not(.pu-block--tight) {
    padding-top: 1rem;
  }

  .pu-about {
    max-width: 26em;
    font-family: var(--font-serif);
    font-size: clamp(1.625rem, 5.2vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /* Weitere Screens: am Handy waagrecht wischbar, ab Tablet nebeneinander */
  .pu-screens {
    display: flex;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding-inline: var(--gutter);
    padding-bottom: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .pu-screens::-webkit-scrollbar {
    display: none;
  }

  .pu-screens__item {
    flex: 0 0 62vw;
    scroll-snap-align: start;
  }

  .pu-screens figcaption {
    margin-top: 0.875rem;
    color: var(--text-2);
  }

  /* Mein Anteil */
  .pu-anteil {
    padding: 2rem 1.5rem;
    background: var(--surface);
    border-radius: 1.5rem;
  }

  .pu-anteil__title {
    font-size: clamp(2.5rem, 9vw, 4rem);
  }

  .pu-anteil__list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .pu-anteil__list li {
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--line);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .pu-anteil__list strong {
    font-weight: 600;
  }

  .pu-anteil__note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }

  /* Sprig */
  .pu-h3 {
    font-size: clamp(2.5rem, 9vw, 4rem);
  }

  .pu-sub {
    margin-top: 0.75rem;
    color: var(--text-2);
  }

  .pu-sprig {
    display: grid;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  /* Die Videos sind auf die Karte zugeschnitten; der Radius blendet die Ecken der Aufnahme aus. */
  .pu-sprig video {
    display: block;
    width: 100%;
    aspect-ratio: 572 / 244;
    object-fit: cover;
    border-radius: 5.6% / 13.2%;
  }

  /* Zahlen */
  .pu-zahlen {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  .pu-zahlen div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .pu-zahlen dt {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-2);
  }

  .pu-zahlen dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  /* Stack, Pitch, Team */
  .pu-facts {
    margin: 0;
  }

  .pu-facts > div {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .pu-facts dd {
    max-width: 44em;
    margin: 0.375rem 0 0;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .pu-intro {
      padding-block: 7rem 6rem;
    }

    .pu-intro__lead {
      margin-top: 1.75rem;
      font-size: 1.375rem;
    }

    .pu-intro :global(.pu-intro__phone) {
      margin-top: 4.5rem;
    }

    .pu-block {
      padding-block: 7rem;
    }

    .pu-block--tight {
      padding-block: 0 7rem;
    }

    .pu-screens {
      justify-content: center;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      max-width: var(--page-max);
      margin: 4.5rem auto 0;
      padding-bottom: 0;
      overflow: visible;
    }

    .pu-screens__item {
      flex: 0 1 17.5rem;
    }

    .pu-anteil {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
      gap: 3rem;
      padding: 4rem;
      border-radius: 2rem;
    }

    .pu-anteil__list {
      margin-top: 0.5rem;
    }

    .pu-anteil__list li {
      padding-block: 1.125rem;
      font-size: 1.125rem;
    }

    .pu-sprig {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .pu-zahlen {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
      padding-block: 2.25rem;
    }

    .pu-zahlen dd {
      font-size: 1.5rem;
    }

    .pu-facts > div {
      display: grid;
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
      padding-block: 1.5rem;
    }

    .pu-facts dd {
      margin-top: 0;
    }
  }
</style>

<script>
  // Sprig-Videos laufen nur, solange sie sichtbar sind. Bei reduzierter Bewegung kein Autoplay.
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-sprig]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced) {
    videos.forEach((v) => (v.controls = true));
  } else if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.35 },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>
